# Copy these values into your shell before running the tools locally.
AWS_REGION=ap-south-1
FINFINE_TENANT_ID=msme-001
DOCUMENT_RECORD_TABLE_NAME=DocumentRecord-ifsueqzwybf6nau7duulv5qweq-NONE
TRANSACTION_TABLE_NAME=Transaction-ifsueqzwybf6nau7duulv5qweq-NONE
OBLIGATION_TABLE_NAME=Obligation-ifsueqzwybf6nau7duulv5qweq-NONE

# Every developer must create their own agent_backend/.env file and use their
# own Groq key. Never commit a real key.
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_ID=qwen/qwen3.8-27b
GROQ_API_KEY=replace-with-your-own-groq-key
MODEL_MAX_TOKENS=2048
MODEL_TEMPERATURE=0

# AgentCore Code Interpreter runs in AWS and keeps a session for each chat.
CODE_INTERPRETER_REGION=ap-south-1
CODE_INTERPRETER_SESSION_TIMEOUT_SECONDS=900

# Browser origins allowed to call the local API. Add the frontend's local URL
# here if it uses a different port.
FINFINE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional: set this when the tables are available through a named AWS profile.
# AWS_PROFILE=your-profile
