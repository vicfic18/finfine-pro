# Copy these values into your shell before running the tools locally.
AWS_REGION=ap-south-1
DOCUMENT_RECORD_TABLE_NAME=DocumentRecord-ifsueqzwybf6nau7duulv5qweq-NONE
TRANSACTION_TABLE_NAME=Transaction-ifsueqzwybf6nau7duulv5qweq-NONE
OBLIGATION_TABLE_NAME=Obligation-ifsueqzwybf6nau7duulv5qweq-NONE

# Optional canonical business tables. Leave unset only when a dataset is not
# provisioned; the agent will report that dataset as unavailable.
# MERCHANT_SETTINGS_TABLE_NAME=MerchantFinancialSettings-ifsueqzwybf6nau7duulv5qweq-NONE
# CASH_POSITION_TABLE_NAME=CashPositionSnapshot-ifsueqzwybf6nau7duulv5qweq-NONE
# PRODUCT_TABLE_NAME=Product-ifsueqzwybf6nau7duulv5qweq-NONE
# SALE_TABLE_NAME=Sale-ifsueqzwybf6nau7duulv5qweq-NONE
# SALE_LINE_ITEM_TABLE_NAME=SaleLineItem-ifsueqzwybf6nau7duulv5qweq-NONE
# INVENTORY_SNAPSHOT_TABLE_NAME=InventorySnapshot-ifsueqzwybf6nau7duulv5qweq-NONE
# INVENTORY_ITEM_TABLE_NAME=InventoryItem-ifsueqzwybf6nau7duulv5qweq-NONE
# PURCHASE_TABLE_NAME=Purchase-ifsueqzwybf6nau7duulv5qweq-NONE
# PURCHASE_LINE_ITEM_TABLE_NAME=PurchaseLineItem-ifsueqzwybf6nau7duulv5qweq-NONE
# SUPPLIER_PROFILE_TABLE_NAME=SupplierProfile-ifsueqzwybf6nau7duulv5qweq-NONE
# SUPPLIER_PRODUCT_TERMS_TABLE_NAME=SupplierProductTerms-ifsueqzwybf6nau7duulv5qweq-NONE
# PURCHASE_ORDER_TABLE_NAME=PurchaseOrder-ifsueqzwybf6nau7duulv5qweq-NONE
# PURCHASE_ORDER_LINE_ITEM_TABLE_NAME=PurchaseOrderLineItem-ifsueqzwybf6nau7duulv5qweq-NONE
# RECURRING_EXPENSE_TABLE_NAME=RecurringExpense-ifsueqzwybf6nau7duulv5qweq-NONE

# Runtime authentication and private agent-session storage.
# Set COGNITO_ISSUER directly, or set COGNITO_USER_POOL_ID to derive it from AWS_REGION.
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/replace-with-user-pool-id
COGNITO_CLIENT_ID=replace-with-user-pool-client-id
AGENT_SESSION_BUCKET_NAME=replace-with-amplify-storage-bucket
AGENT_SESSION_REGION=us-east-1
AGENT_SESSION_PREFIX=agent-sessions/
AGENT_VERSION=v1
AGENT_SESSION_RETENTION_DAYS=30
AGENT_REQUEST_TIMEOUT_SECONDS=90

# Every developer must create their own agent_backend/.env file and use their
# own OpenRouter key. Never commit a real key. Nex N2.5 Pro is the current test
# model; another capable OpenRouter model may be used if it supports tool calls.
OPENROUTER_API_KEY=replace-with-your-own-openrouter-key
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_ID=nex-agi/nex-n2.5-pro:free
MODEL_MAX_TOKENS=2048
MODEL_TEMPERATURE=0

# Python calculations run in the no-secret Lambda executor.
CODE_EXECUTOR_REGION=ap-south-1
CODE_EXECUTOR_FUNCTION_NAME=finfine-code-executor

# Optional: set this when the tables are available through a named AWS profile.
# AWS_PROFILE=your-profile
